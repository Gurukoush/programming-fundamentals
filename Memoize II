function memoize(fn) {
    const cache = new Map();

    return function (...args) {
        let current = cache;

        for (let i = 0; i < args.length; i++) {
            const arg = args[i];

            if (!current.has(arg)) {
                current.set(arg, new Map());
            }

            current = current.get(arg);
        }

        if (current.has("result")) {
            return current.get("result");
        }

        const result = fn(...args);
        current.set("result", result);

        return result;
    };
}
