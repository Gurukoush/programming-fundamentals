import threading

class DiningPhilosophers:

    def __init__(self):
        # 5 forks as locks
        self.forks = [threading.Lock() for _ in range(5)]
        
        # Allow only 4 philosophers at a time
        self.semaphore = threading.Semaphore(4)

    def wantsToEat(self, philosopher: int,
                   pickLeftFork,
                   pickRightFork,
                   eat,
                   putLeftFork,
                   putRightFork) -> None:

        left = philosopher
        right = (philosopher + 1) % 5

        # prevent deadlock
        self.semaphore.acquire()

        # pick forks
        self.forks[left].acquire()
        self.forks[right].acquire()

        pickLeftFork()
        pickRightFork()

        # eat
        eat()

        # put forks
        putRightFork()
        putLeftFork()

        # release forks
        self.forks[right].release()
        self.forks[left].release()

        self.semaphore.release()
